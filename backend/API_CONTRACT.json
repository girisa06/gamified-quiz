{
  "base_url": "http://localhost:8000",
  "note": "Locked at Checkpoint 1. Routes marked \"implemented\": true are live and stubbed in main.py returning dummy data. Routes marked false are contract-only, reserved for later phases so Member 3 can build against the shape now.",
  "routes": [
    {
      "method": "GET",
      "path": "/health",
      "implemented": true,
      "request": null,
      "response": { "status": "ok" }
    },
    {
      "method": "POST",
      "path": "/api/classrooms/create",
      "implemented": true,
      "description": "Teacher creates a new classroom. Generates a unique 4-char code.",
      "request": { "teacher_name": "Ms. Rao (optional)" },
      "response": { "classroom_id": 1, "code": "ABC1" }
    },
    {
      "method": "POST",
      "path": "/api/classrooms/join",
      "implemented": true,
      "description": "Student joins a classroom using its code.",
      "request": { "code": "ABC1", "name": "Arjun" },
      "response": {
        "student_id": 42,
        "classroom_id": 1,
        "avatar_choices": ["🐉", "🤖", "🧙", "🦁", "🚀", "⚡"]
      }
    },
    {
      "method": "GET",
      "path": "/api/classrooms/{classroom_id}/quizzes",
      "implemented": true,
      "description": "List quizzes available in a classroom.",
      "request": null,
      "response": {
        "quizzes": [
          { "id": 1, "title": "Science Basics", "question_count": 15 },
          { "id": 2, "title": "Math Sprint", "question_count": 10 }
        ]
      }
    },
    {
      "method": "GET",
      "path": "/api/quizzes/{quiz_id}",
      "implemented": false,
      "description": "Fetch full quiz with questions. Answer index is withheld here; game logic checks answers server-side.",
      "request": null,
      "response": {
        "quiz": { "id": 1, "title": "Science Basics", "subject": "Science" },
        "questions": [
          {
            "id": 1,
            "q_text": "What planet is closest to the sun?",
            "options": ["Venus", "Mercury", "Earth", "Mars"],
            "difficulty": "easy"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/quizzes/create",
      "implemented": false,
      "description": "Create a quiz and its questions (used by seed script and quiz creators).",
      "request": {
        "classroom_id": 1,
        "title": "Science Basics",
        "subject": "Science",
        "created_by_student_id": 42,
        "questions": [
          {
            "q_text": "What planet is closest to the sun?",
            "options": ["Venus", "Mercury", "Earth", "Mars"],
            "answer_index": 1,
            "difficulty": "easy",
            "explanation": "Mercury orbits closest to the sun."
          }
        ]
      },
      "response": { "quiz_id": 1 }
    },
    {
      "method": "GET",
      "path": "/api/leaderboard/{classroom_id}",
      "implemented": true,
      "description": "Top students in a classroom, sorted by level DESC then xp DESC.",
      "request": null,
      "response": {
        "leaderboard": [
          {
            "student_id": 42,
            "name": "Arjun",
            "avatar": "🐉",
            "level": 3,
            "current_streak": 2,
            "total_xp": 120
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/challenges/create",
      "implemented": false,
      "description": "Student A challenges Student B to a quiz.",
      "request": { "quiz_id": 1, "student_a_id": 42, "student_b_id": 43 },
      "response": { "challenge_id": 7 }
    },
    {
      "method": "GET",
      "path": "/api/challenges/{student_id}",
      "implemented": false,
      "description": "List a student's waiting and finished challenges.",
      "request": null,
      "response": {
        "challenges": [
          {
            "id": 7,
            "quiz_title": "Science Basics",
            "opponent": "Priya",
            "status": "waiting_for_me"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/challenges/{challenge_id}/submit",
      "implemented": false,
      "description": "Submit a score for a challenge. When both players have submitted, winner is decided and XP/level are awarded.",
      "request": { "student_id": 42, "score": 85 },
      "response": { "winner_id": 42, "xp_earned": 15, "level_up": false }
    }
  ]
}
